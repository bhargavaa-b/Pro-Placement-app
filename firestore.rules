rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'bhargavab27@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints (Synced verbatim with firebase-blueprint.json)
    function isValidCandidateProfile(data) {
      return data.keys().hasAll([
        'ownerId',
        'name',
        'university',
        'graduationYear',
        'streakDays',
        'streakShieldActive',
        'highGameScore',
        'solvedDSACount',
        'solvedAptitudeCount',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'name',
        'university',
        'graduationYear',
        'streakDays',
        'streakShieldActive',
        'highGameScore',
        'solvedDSACount',
        'solvedAptitudeCount',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
      data.university is string && data.university.size() >= 1 && data.university.size() <= 160 &&
      data.graduationYear is string && data.graduationYear.size() >= 0 && data.graduationYear.size() <= 16 &&
      data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 10000 &&
      data.streakShieldActive is bool &&
      data.highGameScore is number && data.highGameScore >= 0 && data.highGameScore <= 10000000 &&
      data.solvedDSACount is number && data.solvedDSACount >= 0 && data.solvedDSACount <= 10000 &&
      data.solvedAptitudeCount is number && data.solvedAptitudeCount >= 0 && data.solvedAptitudeCount <= 50000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCandidatePrivateInfo(data) {
      return data.keys().hasAll(['ownerId', 'email', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['ownerId', 'email', 'createdAt', 'updatedAt']) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSolvedProblemRecord(data) {
      return data.keys().hasAll(['ownerId', 'problemId', 'category', 'createdAt']) &&
      data.keys().hasOnly(['ownerId', 'problemId', 'category', 'createdAt']) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.problemId is string && data.problemId.size() >= 1 && data.problemId.size() <= 128 && data.problemId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.category is string && data.category.size() >= 3 && data.category.size() <= 16 &&
      (data.category == 'DSA' || data.category == 'APTITUDE') &&
      data.createdAt is timestamp;
    }

    function isValidAdminNotification(data) {
      return data.keys().hasAll([
        'ownerId',
        'title',
        'message',
        'priority',
        'isBroadcast',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'title',
        'message',
        'priority',
        'isBroadcast',
        'createdAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.message is string && data.message.size() >= 1 && data.message.size() <= 800 &&
      data.priority is string && data.priority.size() >= 4 && data.priority.size() <= 16 &&
      (data.priority == 'info' || data.priority == 'important' || data.priority == 'urgent') &&
      data.isBroadcast is bool &&
      data.createdAt is timestamp;
    }

    // 4. Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        (resource == null || existing().ownerId == request.auth.uid);

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidCandidateProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidCandidateProfile(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action: Update Progress & Profile Details
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'university',
            'graduationYear',
            'streakDays',
            'streakShieldActive',
            'highGameScore',
            'solvedDSACount',
            'solvedAptitudeCount',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        existing().ownerId == request.auth.uid;

      // 5. Subcollection: /users/{userId}/private/{docId} (PII Split Collection)
      match /private/{docId} {
        allow get: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          userId == request.auth.uid &&
          (resource == null || existing().ownerId == request.auth.uid) &&
          get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          userId == request.auth.uid &&
          isValidCandidatePrivateInfo(incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          userId == request.auth.uid &&
          isValidCandidatePrivateInfo(incoming()) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']) &&
          get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;

        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          userId == request.auth.uid &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
      }

      // 6. Subcollection: /users/{userId}/solvedProblems/{problemId}
      match /solvedProblems/{problemId} {
        allow get: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(problemId) &&
          userId == request.auth.uid &&
          (resource == null || existing().ownerId == request.auth.uid) &&
          get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;

        allow list: if isVerifiedUser() &&
          userId == request.auth.uid &&
          resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(problemId) &&
          userId == request.auth.uid &&
          problemId == incoming().problemId &&
          isValidSolvedProblemRecord(incoming()) &&
          incoming().createdAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;

        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(problemId) &&
          userId == request.auth.uid &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
      }
    }

    // 7. Collection: /notifications/{notificationId} (Global Admin Broadcasts)
    match /notifications/{notificationId} {
      allow get: if isVerifiedUser() &&
        isValidId(notificationId) &&
        existing().isBroadcast == true;

      allow list: if isVerifiedUser() &&
        resource.data.isBroadcast == true;

      allow create: if isAdmin() &&
        isValidId(notificationId) &&
        isValidAdminNotification(incoming()) &&
        incoming().createdAt == request.time;

      allow update: if isAdmin() &&
        isValidId(notificationId) &&
        isValidAdminNotification(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'priority', 'isBroadcast']);

      allow delete: if isAdmin() &&
        isValidId(notificationId);
    }
  }
}
